<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/a4"
    tools:context=".SetUsername">

    <EditText
        android:id="@+id/usernameText"
        android:layout_width="217dp"
        android:layout_height="48dp"
        android:layout_marginStart="97dp"
        android:layout_marginTop="7dp"
        android:layout_marginEnd="97dp"
        android:background="@drawable/border"
        android:ems="10"
        android:hint="Username..."
        android:inputType="text"
        android:textColor="@color/grey_orange"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView6" />

    <Button
        android:id="@+id/setUsernameButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="155dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="155dp"
        android:backgroundTint="@color/a1"
        android:text="Proceed"
        android:textColor="@color/a3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/usernameText" />

    <TextView
        android:id="@+id/textView6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="97dp"
        android:layout_marginTop="271dp"
        android:layout_marginEnd="150dp"
        android:text="Enter username (Optional)"
        android:textColor="@color/a3"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/skipButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="189dp"
        android:layout_marginTop="33dp"
        android:layout_marginEnd="195dp"
        android:text="Skip"
        android:textColor="@color/a3"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/setUsernameButton" />

</androidx.constraintlayout.widget.ConstraintLayout>